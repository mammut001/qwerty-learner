# Node/SQLite on a VM with a persistent disk and Docker Compose v2.24+.
# DNS A/AAAA records must resolve to that VM; inbound 80/443 must be open.
STUDY_DOMAIN=study.example.com
ACME_EMAIL=you@example.com
# Compose derives STUDY_ORIGIN=https://STUDY_DOMAIN and forces
# STUDY_COOKIE_SECURE=true. Database stays in the study-data volume.

# Optional. When set, the site shows a password screen and every data route requires it.
# Changing the value signs every device out.
# STUDY_ACCESS_PASSWORD=
