# Copy to deploy/.env (ignored). Node 24 reads this only for deploy:free.
# Use a Cloudflare Workers FREE account; this script never upgrades or adds billing.
# Create an API token scoped to your account with:
# Account Settings:Read, Workers Scripts:Edit, D1:Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Set once; keep stable on redeploy to preserve the URL, cookie, and database.
STUDY_APP_NAME=qwerty-study-plan
# Optional for an existing workers.dev subdomain. On a new account it is registered.
STUDY_WORKERS_SUBDOMAIN=
# Optional existing D1 database UUID; otherwise finds/creates one with the app name.
STUDY_D1_ID=
# Optional: exact public frontend HTTPS origin when using a separate Nginx proxy.
# Leave empty for the default same-origin Workers hosting.
STUDY_ORIGIN=
