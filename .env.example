# Vite build-time public setting: never put secrets in VITE_* variables.
# Empty: /api/study-plan at the frontend origin (recommended).
# Separate API: https://YOUR-APP.YOUR-SUBDOMAIN.workers.dev (origin only, no /api).
VITE_STUDY_API_BASE_URL=
# Node backend (or Compose). Exact frontend origin, without trailing slash/path.
STUDY_ORIGIN=http://localhost:5173
STUDY_COOKIE_SECURE=false
# strict for same-origin; none + secure=true for cross-site HTTPS browser calls.
STUDY_COOKIE_SAME_SITE=strict

# Speech recognition (Deepgram Nova-3) - server-side only; never expose in VITE_*
# DEEPGRAM_API_KEY=
# STUDY_ASR_DAILY_LIMIT=300

# Stripe subscriptions (Pro). Billing stays OFF unless all three are set. Use sk_test_ / whsec_ / price_ test values first.
# Server-side only; never expose in VITE_*. Webhook endpoint: ${STUDY_ORIGIN}/api/study-plan/billing/webhook
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
